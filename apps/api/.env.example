### Example environment file for apps/api FastAPI service
# Copy this file to .env and fill values for local development.

# MongoDB connection string (leave empty to run in local scaffold mode)
# Examples:
#  - Local: mongodb://localhost:27017
#  - Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net
MONGODB_URL=

# Database and collection names
MONGODB_DATABASE=hybrid_rag
MONGODB_DOCUMENTS_COLLECTION=documents
MONGODB_CHUNKS_COLLECTION=chunks

# Optional: override host/port when running uvicorn
# UVICORN_HOST=127.0.0.1
# UVICORN_PORT=8000
